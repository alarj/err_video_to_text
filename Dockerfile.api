FROM python:3.12-slim

ARG UGLYERR_REF
ARG YTDLP_VERSION

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY backend ./backend
COPY tests ./tests
COPY db/schema ./db/schema
COPY frontend_dist ./frontend_dist
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && test -n "$UGLYERR_REF" \
    && test -n "$YTDLP_VERSION" \
    && pip install --no-cache-dir ".[api,test]" "yt-dlp==${YTDLP_VERSION}" \
    && pip install --no-cache-dir "git+https://github.com/smarbaa/yt-dlp-ugly-err.git@${UGLYERR_REF}"

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/backend:/app/src
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
