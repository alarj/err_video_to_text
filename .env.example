# Required before running speaker diarization. Never commit the real value.
HF_TOKEN=

# Runtime state is intentionally outside the repository checkout.
ERR2TEXT_RUNTIME_ROOT=/srv/err2text
ERR2TEXT_PYTORCH_THREADS=3
# Set these to `id -u` and `id -g` on the host. They prevent root-owned output files.
ERR2TEXT_UID=
ERR2TEXT_GID=

# Immutable, audited git commit SHA of yt-dlp-ugly-err for the Docker build.
UGLYERR_REF=

# Optional Oracle connection. Keep real passwords only in the local .env file.
ORACLE_ENABLED=yes
ORACLE_USER=errvideo2text
ORACLE_PASSWORD=
ORACLE_DSN=woqc8ar450a6cum0_tp
ORACLE_CONFIG_DIR=/home/ubuntu/Oracle/Wallet_WOQC8AR450A6CUM0
ORACLE_WALLET_LOCATION=/home/ubuntu/Oracle/Wallet_WOQC8AR450A6CUM0
ORACLE_WALLET_PASSWORD=

# MVP2.1: initial CPU policy is one diarization job at a time.
ERR2TEXT_MAX_CONCURRENT_DIARIZATIONS=1
