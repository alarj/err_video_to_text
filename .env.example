# Required before running speaker diarization. Never commit the real value.
HF_TOKEN=

# Runtime state is intentionally outside the repository checkout.
ERR2TEXT_RUNTIME_ROOT=/srv/err2text
ERR2TEXT_PYTORCH_THREADS=3
# Set these to `id -u` and `id -g` on the host. They prevent root-owned output files.
ERR2TEXT_UID=
ERR2TEXT_GID=

# Immutable, audited git commit SHA of yt-dlp-ugly-err for the Docker build.
UGLYERR_REF=
